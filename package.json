{
  "name": "codebase-intelligence",
  "version": "0.1.0",
  "private": true,
  "description": "Persistent, evidence-backed codebase intelligence graph powering a canvas, grounded chat, and context-aware PR review.",
  "workspaces": [
    "packages/*",
    "apps/*",
    "workers/*"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:api": "tsx watch apps/api/src/index.ts",
    "dev:web": "npm --workspace @cbi/web run dev",
    "dev:indexer": "tsx watch workers/indexer/src/index.ts",
    "dev:reviewer": "tsx watch workers/pr-reviewer/src/index.ts",
    "cli": "tsx apps/cli/src/index.ts",
    "smoke": "node scripts/smoke.mjs",
    "migrate": "tsx apps/cli/src/index.ts migrate",
    "infra:up": "docker compose up -d postgres redis",
    "infra:down": "docker compose down"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
