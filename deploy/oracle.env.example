# Replace every placeholder. Keep the completed file private on the VM.
POSTGRES_DB=cbi
POSTGRES_USER=cbi
POSTGRES_PASSWORD=REPLACE_WITH_64_HEX_CHARACTERS

# Public hostnames configured on your Cloudflare Tunnel.
APP_URL=https://app.example.com
NEXT_PUBLIC_API_URL=https://api.example.com
CLOUDFLARE_TUNNEL_TOKEN=REPLACE_WITH_TUNNEL_TOKEN

# GitHub App. Store the PEM as one quoted line with literal \n between lines.
GITHUB_APP_ID=REPLACE_WITH_APP_ID
GITHUB_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_PRIVATE_KEY\n-----END PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=REPLACE_WITH_WEBHOOK_SECRET

# Required for AI chat and AI-assisted PR reviews.
OPENROUTER_API_KEY=REPLACE_WITH_OPENROUTER_KEY

# Optional GitHub token fallback.
GITHUB_TOKEN=