# Application
# Public web URL; hosts the logo embedded in GitHub review comments when HTTPS.
APP_URL=http://localhost:3000
API_URL=http://localhost:8787
NODE_ENV=development
PORT=8787

# Google-only sign-in. Keep the session secret on the API host only.
# Generate SESSION_SECRET with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Passwords, magic links, and development login bypasses are disabled.
SESSION_SECRET=

# Supabase Auth. The service-role key belongs only on the API host (e.g. Render).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Database (required in production for workspaces, sessions, and credentials)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cbi

# Redis
REDIS_URL=redis://localhost:6379

# GitHub App
# The App must grant "Contents: read", "Pull requests: write" and "Issues: write"
# AND the repository must be selected for the installation, otherwise reviews run
# but no comment can be posted.
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Users connect their own GitHub token inside their workspace. Shared environment
# tokens and installation credentials are never used for tenant repository access.
# Saved user tokens are encrypted at rest using a key derived from SESSION_SECRET.

# AI (OpenRouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_URL=http://localhost:3000
OPENROUTER_APP_TITLE=Codebase Intelligence

# Embeddings (optional — falls back to a deterministic local provider)
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# Web API proxy target (server-side Next.js rewrite; never expose it as NEXT_PUBLIC).
API_PROXY_TARGET=http://localhost:8787

# Local checkouts (optional)
CBI_CHECKOUT_DIR=

# Logging
LOG_LEVEL=info

# Encryption
AUTH_SECRET=dev-only-change-me
ENCRYPTION_KEY=dev-only-32-byte-key-change-me!!!
