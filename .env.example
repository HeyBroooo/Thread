# Application
# Public web URL; hosts the logo embedded in GitHub review comments when HTTPS.
APP_URL=http://localhost:3000
API_URL=http://localhost:8787
NODE_ENV=development
PORT=8787

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cbi

# Redis
REDIS_URL=redis://localhost:6379

# GitHub App
# The App must grant "Contents: read", "Pull requests: write" and "Issues: write"
# AND the repository must be selected for the installation, otherwise reviews run
# but no comment can be posted.
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Personal access token — the fallback that works for private repositories with a
# single paste, and raises the API rate limit from 60/h to 5000/h. Classic tokens
# need the `repo` scope; fine-grained tokens need Contents: read + Pull requests: write.
# You can also paste this at runtime from the Pull requests page.
GITHUB_TOKEN=

# AI (OpenRouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_URL=http://localhost:3000
OPENROUTER_APP_TITLE=Codebase Intelligence

# Embeddings (optional — falls back to a deterministic local provider)
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# Web
NEXT_PUBLIC_API_URL=http://localhost:8787

# Local checkouts (optional)
CBI_CHECKOUT_DIR=

# Logging
LOG_LEVEL=info

# Encryption
AUTH_SECRET=dev-only-change-me
ENCRYPTION_KEY=dev-only-32-byte-key-change-me!!!
